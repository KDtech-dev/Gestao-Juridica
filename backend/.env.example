APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=advocacia-gestao
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="contato@almeidacosta.example"
MAIL_FROM_NAME="Almeida & Costa Advocacia"
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=449135
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FRONTEND_URL=http://localhost:3000

# WhatsApp Cloud API: off by default. simulation never makes external requests.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=simulation
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Select a supported Graph version in Meta (e.g. v26.0); required for real sends.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
# Independent secret for the webhook GET challenge, NOT the App Secret.
WHATSAPP_VERIFY_TOKEN=
# International format with +; comma separated. Empty means deny ALL test sends.
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_TIMEZONE=America/Sao_Paulo
WHATSAPP_DAILY_TIME=08:00
WHATSAPP_DIAGNOSTIC_TEMPLATE=hello_world
# Leave blank until approved in the target WABA. Body parameter contracts: backend/WHATSAPP.md.
WHATSAPP_TEMPLATE_DAILY_PT=
WHATSAPP_TEMPLATE_DAILY_EN=
WHATSAPP_TEMPLATE_DAILY_ES=
WHATSAPP_TEMPLATE_REMINDER_PT=
WHATSAPP_TEMPLATE_REMINDER_EN=
WHATSAPP_TEMPLATE_REMINDER_ES=
WHATSAPP_TEMPLATE_CHANGE_PT=
WHATSAPP_TEMPLATE_CHANGE_EN=
WHATSAPP_TEMPLATE_CHANGE_ES=
